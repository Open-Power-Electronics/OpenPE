# Dependencies and renderer build output
node_modules/
/.next/
/out/
/release/
/release-*/
/next-env.d.ts
*.tsbuildinfo

# Local workspace state, experiments and verification output
/promotion/
/.openpe/
/test-results/
/tmp/
/coverage/
*.log
*.pid
*.cpuprofile
*.heapsnapshot

# Prepared libraries, solvers and downloaded corresponding sources
/resources/kicad/
/resources/ngspice/
/resources/thermal/
/resources/examples/
/resources/third-party-source/*
!/resources/third-party-source/newstroke-10.0.0/
/resources/example-catalog/simulation/models/
/resources/example-catalog/footprints/emc-flyback/models/

# Prepared project assets; EMC's four authored SPICE libraries stay tracked
/examples/**/models/
!/examples/project/emc-flyback/models/
/examples/project/emc-flyback/models/*
!/examples/project/emc-flyback/models/*.lib
/examples/**/circuits/
/examples/**/3D/*.step
/examples/**/footprints/*.step
/examples/**/licenses/
/examples/**/datasheets/*.pdf
/tests/fixtures/**/models/
/tests/fixtures/**/circuits/

# Solver results and publication backups beside native example/test projects
/examples/**/spice-simulation/
/examples/**/layout-thermal/
/examples/**/spice/
/examples/**/thermal/
/examples/**/*-backups/
/tests/fixtures/**/spice-simulation/
/tests/fixtures/**/layout-thermal/
/tests/fixtures/**/spice/
/tests/fixtures/**/thermal/
/tests/fixtures/**/*-backups/

# KiCad local UI state, locks and autosaves; native design files stay tracked
*.kicad_prl
~*.lck
_autosave-*.kicad_sch
_autosave-*.kicad_pcb

# Python and operating-system caches
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
Desktop.ini

# Local environment and private signing material; example templates stay tracked
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
