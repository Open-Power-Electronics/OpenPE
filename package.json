{
  "name": "openpe",
  "version": "0.1.1",
  "description": "Local electrical engineering studio",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "ai.openpe.desktop.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "pretypecheck": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs && node scripts/e2e-project.mjs && node scripts/e2e-sessions.mjs && node scripts/e2e-permissions.mjs && node scripts/e2e-libraries.mjs && node scripts/e2e-workspace.mjs",
    "package": "node scripts/package-desktop.mjs",
    "examples": "node --import tsx scripts/prepare-emc-analytical-models.ts && node scripts/build-emc-flyback-assets.mjs && node --import tsx scripts/build-reference-examples.ts && node --import tsx scripts/build-emc-flyback-example.ts",
    "examples:emc-flyback": "node --import tsx scripts/prepare-emc-analytical-models.ts && node scripts/build-emc-flyback-assets.mjs && node --import tsx scripts/build-emc-flyback-example.ts",
    "examples:prepare": "node scripts/build.mjs --examples",
    "examples:check-models": "node scripts/check-reference-models.mjs",
    "datasheets:download": "node scripts/example-datasheets.mjs --download",
    "datasheets:check": "node scripts/example-datasheets.mjs --verify",
    "build:format": "node scripts/build-format.mjs",
    "pretest": "node scripts/build-format.mjs && node scripts/check-architecture.mjs",
    "libraries:download": "node scripts/download-libraries.mjs && node scripts/download-parser-source.mjs",
    "libraries:download-models": "node scripts/download-kicad-models.mjs",
    "prepackage": "npm run libraries:download",
    "libraries:verify": "node scripts/verify-libraries.mjs",
    "simulation:prepare": "node scripts/prepare-ngspice.mjs",
    "simulation:verify": "node scripts/prepare-ngspice.mjs --verify",
    "simulation:check-examples": "node --import tsx scripts/check-example-simulations.ts",
    "simulation:build-emc-flyback": "node --import tsx scripts/build-emc-flyback-simulation.ts && node scripts/build-format.mjs && node --import tsx scripts/prepare-emc-flyback-models.ts",
    "simulation:check-emc-flyback": "node --import tsx scripts/check-emc-flyback-simulation.ts",
    "simulation:download-examples": "node --import tsx scripts/download-example-models.ts",
    "thermal:prepare": "node scripts/prepare-thermal.mjs",
    "thermal:verify": "node scripts/prepare-thermal.mjs --verify",
    "thermal:check-example": "node --import tsx scripts/check-thermal-example.ts",
    "thermal:check-emc-flyback": "node --import tsx scripts/check-emc-flyback-thermal.ts",
    "thermal:check-emc-flyback-ui": "node scripts/check-emc-flyback-thermal-ui.mjs",
    "cad:check-model": "node --import tsx scripts/check-model-cad.ts",
    "agent:check-cursor": "electron scripts/check-cursor-agent.cjs",
    "solvers:build-macos": "node scripts/build-macos-solvers.mjs",
    "solvers:build-linux": "node scripts/build-linux-solvers.mjs",
    "solvers:publish": "node scripts/publish-solver-releases.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "express": "^5.1.0",
    "occt-import-js": "0.0.23",
    "pdfjs-dist": "6.5.438",
    "quickjs-emscripten": "0.32.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/clipper-lib": "6.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "ajv": "8.20.0",
    "clipper-lib": "6.4.2",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "resedit": "1.7.2",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "build": {
    "appId": "ai.openpe.desktop",
    "productName": "OpenPE",
    "afterPack": "build/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "resources/example-catalog/manifest.json",
      "resources/example-catalog/home-manifest.json",
      "resources/example-catalog/emc-flyback-assets.json",
      "resources/example-catalog/sources/emc-flyback/LICENSE",
      "resources/example-catalog/sources/emc-flyback/design/EMC_Demo.pretty/**/*",
      "resources/example-catalog/sources/emc-flyback/design/EMC_Demo.3dshapes/**/*",
      "resources/example-catalog/footprints/**/*",
      "server/**/*",
      "plugins/catalog.mjs",
      "plugins/*/manifest.json",
      "plugins/*/host/**/*",
      "plugins/*/electron/**/*",
      "plugins/*/resources/**/*",
      "plugins/runtime/*.mjs",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/openpe.ico",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "extraResources": [
        {
          "from": "resources/ngspice/47",
          "to": "ngspice/47",
          "filter": [
            "Spice64/bin/ngspice_con.exe",
            "Spice64/bin/libomp140.x86_64.dll",
            "Spice64/bin/sndfile.dll",
            "Spice64/bin/samplerate.dll",
            "Spice64/lib/ngspice/analog.cm",
            "Spice64/lib/ngspice/digital.cm",
            "Spice64/lib/ngspice/spice2poly.cm",
            "Spice64/lib/ngspice/table.cm",
            "Spice64/lib/ngspice/tlines.cm",
            "Spice64/lib/ngspice/xtradev.cm",
            "Spice64/lib/ngspice/xtraevt.cm",
            "Spice64/docs/COPYING",
            "Spice64/docs/AUTHORS",
            "Spice64/share/ngspice/scripts/spinit"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/openpe.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/ngspice/47",
          "to": "ngspice/47",
          "filter": [
            "Spice64/bin/ngspice",
            "Spice64/bin/libomp.dylib",
            "Spice64/bin/libsndfile.1.dylib",
            "Spice64/bin/libsamplerate.0.dylib",
            "Spice64/lib/ngspice/analog.cm",
            "Spice64/lib/ngspice/digital.cm",
            "Spice64/lib/ngspice/spice2poly.cm",
            "Spice64/lib/ngspice/table.cm",
            "Spice64/lib/ngspice/tlines.cm",
            "Spice64/lib/ngspice/xtradev.cm",
            "Spice64/lib/ngspice/xtraevt.cm",
            "Spice64/docs/COPYING",
            "Spice64/docs/AUTHORS",
            "Spice64/share/ngspice/scripts/spinit"
          ]
        }
      ]
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/brand/openpe-icon.png",
      "category": "Development",
      "maintainer": "OpenPE maintainers <openpe@users.noreply.github.com>",
      "executableName": "openpe",
      "extraResources": [
        {
          "from": "resources/ngspice/47",
          "to": "ngspice/47",
          "filter": [
            "Spice64/bin/libgcc_s.so.1",
            "Spice64/bin/libgomp.so.1",
            "Spice64/bin/libsamplerate.so.0",
            "Spice64/bin/libsndfile.so.1",
            "Spice64/bin/libstdc++.so.6",
            "Spice64/bin/ngspice",
            "Spice64/docs/AUTHORS",
            "Spice64/docs/COPYING",
            "Spice64/docs/build/build-ngspice-linux.sh",
            "Spice64/docs/build/linux-bundle.sh",
            "Spice64/docs/build/ngspice-47-linux-codemodel-path.patch",
            "Spice64/docs/gcc/COPYING.LIB",
            "Spice64/docs/gcc/COPYING.RUNTIME",
            "Spice64/docs/gcc/COPYING3",
            "Spice64/docs/libsamplerate-COPYING",
            "Spice64/docs/libsndfile-COPYING",
            "Spice64/lib/ngspice/analog.cm",
            "Spice64/lib/ngspice/digital.cm",
            "Spice64/lib/ngspice/spice2poly.cm",
            "Spice64/lib/ngspice/table.cm",
            "Spice64/lib/ngspice/tlines.cm",
            "Spice64/lib/ngspice/xtradev.cm",
            "Spice64/lib/ngspice/xtraevt.cm",
            "Spice64/share/ngspice/scripts/spinit"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerIcon": "build/installer-mark.ico",
      "installerHeader": null,
      "installerSidebar": "build/installerSidebar.bmp",
      "installerLanguages": [
        "en_US"
      ]
    },
    "extraResources": [
      {
        "from": "examples",
        "to": "examples-native",
        "filter": [
          "**/*",
          "!project",
          "!project/**",
          "!**/*.[lL][iI][bB]",
          "!**/spice/**",
          "!**/spice-simulation/**",
          "!**/thermal/**",
          "!**/layout-thermal/**",
          "!**/*.[pP][dD][fF]",
          "!**/.*",
          "!**/.*/**",
          "!**/history.git/**",
          "!**/node_modules/**",
          "!**/cache/**",
          "!**/simulation-cache/**",
          "!**/*-backups/**",
          "!**/*.kicad_prl",
          "!**/*.pem",
          "!**/*.key",
          "!**/*.pfx",
          "!**/*.p12"
        ]
      },
      {
        "from": "examples/project",
        "to": "project-native",
        "filter": [
          "**/*",
          "!**/spice/**",
          "!**/spice-simulation/**",
          "!**/thermal/**",
          "!**/layout-thermal/**",
          "!**/*.[pP][dD][fF]",
          "!**/models/ti/**",
          "!**/.*",
          "!**/.*/**",
          "!**/history.git/**",
          "!**/node_modules/**",
          "!**/cache/**",
          "!**/simulation-cache/**",
          "!**/*-backups/**",
          "!**/*.kicad_prl",
          "!**/*.pem",
          "!**/*.key",
          "!**/*.pfx",
          "!**/*.p12"
        ]
      },
      {
        "from": "resources/thermal/1",
        "to": "thermal/1",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/kicad/10.0.0",
        "to": "kicad/10.0.0",
        "filter": [
          "library-index.json",
          "symbols/**/*",
          "footprints/**/*",
          "models/LICENSE.md",
          "models/Resistor_SMD.3dshapes/R_0805_2012Metric.step",
          "models/Capacitor_SMD.3dshapes/C_0805_2012Metric.step",
          "models/Package_TO_SOT_SMD.3dshapes/SOT-23.step",
          "!**/.git/**"
        ]
      },
      {
        "from": "resources/third-party-source",
        "to": "third-party-source",
        "filter": [
          "occt-import-js-0.0.23.tar.gz",
          "opencascade-d2abb6d-source.tar.gz",
          "manifest.json",
          "README.txt",
          "newstroke-10.0.0/**/*",
          "ngspice-47.tar.gz",
          "libsndfile-1.2.2.tar.gz",
          "libsamplerate-0.2.2.tar.gz",
          "gcc-14_14.2.0.orig.tar.gz",
          "gcc-14_14.2.0-19.debian.tar.xz"
        ]
      },
      {
        "from": "resources/ngspice/47",
        "to": "ngspice/47",
        "filter": [
          "manifest.json",
          "SOURCE-NOTICE.txt"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/occt-import-js/**/*",
      "node_modules/@napi-rs/**/*"
    ],
    "deb": {
      "depends": [
        "libc6 (>= 2.41)",
        "libgtk-3-0t64 | libgtk-3-0",
        "libnss3",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "xdg-utils",
        "libglu1-mesa",
        "libgl1",
        "libxrender1",
        "libxcursor1",
        "libxfixes3",
        "libxext6",
        "libxft2",
        "libfontconfig1",
        "libxinerama1",
        "libx11-6"
      ]
    }
  }
}
