(symbol "PEBench:Source_Annotations" (in_bom no) (on_board no) (property "Reference" "#GRAPHICS" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Value" "Source annotations" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (symbol "Source_Annotations_1_1" (text "63V" (at 31.496 11.176 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Switch\nInput" (at 201.422 74.168 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "B-Coil" (at 130.048 10.668 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "A-Coil" (at 130.302 23.622 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Supply\nConnector" (at 79.756 22.098 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Ground\nConnector" (at 79.756 9.906 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "SJ1 allows user to\nselect external power\nover comm headers\nor internal 3.3V power.\nNB- DO NOT connect\nexternal power to JP1\nor JP2 when internal\nsupply is selected!" (at 149.86 157.48 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Next\nBoard" (at 50.8 127 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Prev Board/\nController" (at 50.8 154.94 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Meta\nOut" (at 53.34 93.98 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Meta\nIn" (at 53.34 73.66 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "ADC is 5-bit 0-3.3V range.\nR4 should be populated with\na 200k pot for supply\nvoltage compensation; see\ndatasheet p36 for details." (at 200.66 121.92 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "SPI Data is MSB first,\nSPI mode 3:\nCPOL=CPHA=1\n5 Mbit max" (at 21.082 172.974 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (polyline (pts (xy 157.48 147.32) (xy 154.94 147.32)) (stroke (width 0.508) (type default)) (fill (type none))) (polyline (pts (xy 0 53.34) (xy 73.66 53.34)) (stroke (width 0.3048) (type default)) (fill (type none))) (polyline (pts (xy 73.66 53.34) (xy 73.66 185.42)) (stroke (width 0.3048) (type default)) (fill (type none))) (polyline (pts (xy 147.32 35.56) (xy 73.66 35.56)) (stroke (width 0.3048) (type default)) (fill (type none))) (polyline (pts (xy 73.66 35.56) (xy 73.66 53.34)) (stroke (width 0.3048) (type default)) (fill (type none))) (text "Mike Hord\n" (at 172.72 7.62 0) (effects (font (size 2.54 2.54)) (justify left bottom))) (text "Vs must be between 8V and 45V\nMotor supply must be enabled\nfor chip comms to work!" (at 3.048 42.164 0) (effects (font (size 2.54 2.54)) (justify left bottom))) (text "13" (at 238.76 7.62 0) (effects (font (size 2.54 2.54)) (justify left bottom))) (text "SJ3 allows you to route the SDO (serial \ndata out) either to the next board (if this \nboard is in a chain) or back to the previous \nboard (if this board is the last or only board \nin the chain). It defaults to back to previous \nboard, for single board applications." (at 76.2 167.64 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "FLAGN" (at 98.552 102.108 90) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "BUSYN" (at 88.392 99.568 90) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "VLOGIC" (at 159.004 118.618 90) (effects (font (size 1.27 1.27)) (justify left bottom))) (text "VLOGIC" (at 117.348 150.368 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (text "PGND" (at 117.602 61.468 0) (effects (font (size 1.778 1.778)) (justify left bottom))))))
