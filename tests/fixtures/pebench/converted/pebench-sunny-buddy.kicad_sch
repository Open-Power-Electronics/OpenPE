(symbol "PEBench:SparkFun-Aesthetics/FIDUCIAL/1X2" (pin_numbers hide) (pin_names (offset 1.016) hide) (in_bom yes) (on_board yes) (property "Reference" "FID" (at 0 2.54 0) (effects (font (size 1.27 1.27)))) (property "Value" "FIDUCIAL" (at 0 -2.54 0) (effects (font (size 1.27 1.27)))) (symbol "SparkFun-Aesthetics/FIDUCIAL/1X2_1_1" (polyline (pts (xy -0.762 0.762) (xy 0.762 -0.762)) (stroke (width 0.254) (type default)) (fill (type none))) (polyline (pts (xy 0.762 0.762) (xy -0.762 -0.762)) (stroke (width 0.254) (type default)) (fill (type none))) (circle (center 0 0) (radius 1.27) (stroke (width 0.254) (type default)) (fill (type none)))))
(symbol "PEBench:Source_Annotations" (in_bom no) (on_board no) (property "Reference" "#GRAPHICS" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Value" "Source annotations" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (symbol "Source_Annotations_1_1" (text "To add a second bank\nof solar cells, short JP2\nand clear JP1." (at 78.74 50.8 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "NB: With both JP1 and JP2\nshorted, the second power\ninput is also shorted! \nThis may result in damage\nto your power source.\nYou've been warned!" (at 78.74 33.02 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "v13" (at 237.236 6.858 0) (effects (font (size 3.81 3.81)) (justify left bottom))) (text "M. Hord" (at 170.434 7.366 0) (effects (font (size 3.81 3.81)) (justify left bottom))) (text "Cut the JP3 trace to\nmeasure output current.\nAdjust trim pot until output\ncurrent reaches its maximum." (at 167.894 147.828 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "R_SEN is in parallel with R1.\nSmall resistors can be added\nto increase the charge current\nfrom the default ~450mA." (at 137.16 93.98 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "0.22 -> 800mA" (at 139.7 71.12 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Ichg = .1/(R1||Rsen)" (at 139.7 88.9 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Typical R_SEN values vs. Ichg" (at 139.7 83.82 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "1.0  -> 550mA" (at 139.7 78.74 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "0.33 -> 750mA" (at 139.7 73.66 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "0.5  -> 650mA" (at 139.7 76.2 0) (effects (font (size 1.778 1.778)) (justify left bottom))) (text "Voltage at SET can be used to\nset MPPT level. In full sun,\nadjust pot until V_SET = 2.8V." (at 38.1 149.86 0) (effects (font (size 1.778 1.778)) (justify left bottom))))))
