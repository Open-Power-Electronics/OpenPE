        (text " Brian Schmalz"
          (at 169.672 11.43 0)
          (effects
            (font
              (size 1.778 1.778))
            (justify left bottom)))
        (text "Produced by SparkFun Electronics"
          (at 148.59 6.35 0)
          (effects
            (font
              (size 1.778 1.778))
            (justify left bottom)))
        (text "Voltage regulator can supply 100mA"
          (at 142.24 53.34 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Must use LM317"
          (at 71.12 58.42 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "For 35V V+ input"
          (at 71.12 55.88 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "APWR Normally Shorted"
          (at 99.06 60.96 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Cut to use your own"
          (at 99.06 58.42 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Vcc source from JP14 VCC"
          (at 99.06 55.88 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Power Input JP1, JP7"
          (at 2.54 60.96 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "8V to 35V DC"
          (at 2.54 58.42 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "only 15mA of which the BED needs."
          (at 142.24 50.8 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "The rest you can use, if you want"
          (at 142.24 48.26 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "3/5V Normally Open -> Vcc=5.0V"
          (at 83.82 30.48 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "3/5V Closed -> Vcc = 3.3V"
          (at 83.82 27.94 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "to GND or Vcc to override"
          (at 78.74 162.56 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "SLEEP = Vcc (awake)"
          (at 78.74 157.48 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "MS1 = Vcc (1/16 microstep)"
          (at 78.74 154.94 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "MS2 = Vcc (1/16 microstep)"
          (at 78.74 152.4 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "ENABLE = GND (enabled)"
          (at 78.74 149.86 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "RESET = Vcc (not reset)"
          (at 78.74 147.32 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "MS3 = Vcc (1/16 microstep)"
          (at 78.74 144.78 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Short JP10, or JP6 pins "
          (at 78.74 165.1 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "DEFAULT OPTIONS"
          (at 78.74 167.64 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "BigEasyDriver v1.6a"
          (at 2.54 177.8 0)
          (effects
            (font
              (size 5.08 5.08))
            (justify left bottom)))
        (text "DIR is level sensitive"
          (at 5.08 99.06 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "A rising edge on STEP"
          (at 5.08 96.52 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Both take 0V to Vcc"
          (at 5.08 91.44 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Coil A of motor across"
          (at 5.08 78.74 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Coil B of motor across"
          (at 5.08 73.66 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "COILA+ and COILA-"
          (at 5.08 76.2 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "COILB+ and COILB-"
          (at 5.08 71.12 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "causes a step"
          (at 5.08 93.98 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "An easy to use bipolar stepper motor driver"
          (at 7.62 167.64 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Use 4 wire, 6 wire or 8 wire steper motors"
          (at 7.62 165.1 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "From 0mA/phase to over 2A/phase"
          (at 7.62 162.56 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Defaults to 5V for Vcc (logic supply), settable to 3.3V"
          (at 7.62 160.02 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Supply 8V to 35V DC power input on JP1 or JP7"
          (at 7.62 157.48 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Do not connect or disconnect motor"
          (at 7.62 154.94 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "while BigEasyDriver is powered"
          (at 7.62 152.4 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Current adjust pot: adjusts max coil\ncurrent. R13 set such that:\nAt VCC = 3.3V, full clockwise = 2.08A coil current\nAt VCC = 5V, 64% clockwise = 2.0A coil current\nNote driver can only output 2A coil current,\nand is dependent on input voltage, motor,\nand heat sinking/fan to reach this."
          (at 141.986 60.96 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "www.schmalzhaus.com/BigEasyDriver"
          (at 2.54 172.72 0)
          (effects
            (font
              (size 2.54 2.54))
            (justify left bottom)))
        (text "Both C14 and C1 must"
          (at 50.8 30.48 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Be rated for >=50V"
          (at 50.8 27.94 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Change List:"
          (at 2.54 25.4 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "v1.0 BPS Origonal version"
          (at 2.54 24.13 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "D.N.I"
          (at 41.656 137.16 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "D.N.I"
          (at 71.628 137.16 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text ".100\" Headers"
          (at 41.656 139.954 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "3.5mm Screw Terminals"
          (at 71.628 139.7 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "v1.1 BPS Added pull-ups, re-routed"
          (at 2.54 22.86 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "Bi-polar Stepper Motor Outputs"
          (at 2.54 81.28 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "D.N.I"
          (at 13.716 53.34 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "v1.2 5/2/11 BPS Silk screen corrections, sense resistors now .11 ohms"
          (at 2.54 21.59 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "from the VCC pin."
          (at 142.24 45.72 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "SparkFun design rules applied - minor layout tweaks, R13 now 2.49K"
          (at 5.08 20.32 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "NOTE: VCC is normally an OUTPUT. You do not need to "
          (at 137.16 177.8 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "supply power to the Big Easy Driver through VCC."
          (at 137.16 175.26 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "The only power needed is through M+ (motor power)."
          (at 137.16 172.72 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "v1.3 SF 1/10/12"
          (at 2.54 19.05 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "-updated footprint for driver IC (1:1)"
          (at 5.08 17.78 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "-ran all traces directly away from IC"
          (at 5.08 16.51 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "-moved vias and retraced as necessary on VCC and TOP layers"
          (at 5.08 15.24 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "v16a"
          (at 238.76 7.62 0)
          (effects
            (font
              (size 2.54 2.54))
            (justify left bottom)))
        (text "Revised by Patrick Alberts"
          (at 148.59 8.89 0)
          (effects
            (font
              (size 1.778 1.778))
            (justify left bottom)))
        (text "v1.4 SF 4/17/2013 Fixed current adjustment pot silk so directions are correct"
          (at 2.54 13.97 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "v1.5 SF 6/27/2013"
          (at 2.54 12.7 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "v1.6 BPS 3/28/2014"
          (at 2.54 8.89 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "Changed license from CC by 3.0 to CC by-sa 3.0"
          (at 5.08 10.16 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "Updated to standard 0603 foorprints, some rerouting, schematic nets changed"
          (at 5.08 11.43 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "Removed large hole in solder mask on bottom"
          (at 5.08 7.62 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "Changed R13 to 8.2K to improve range of current adjust pot"
          (at 5.08 6.35 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom)))
        (text "You only need to connect M+, \nGND, STEP, DIR and the motor \noutputs. All other I/O is set to \ndefault to 1/16th microstep \nmode, and connections are \nnot required for basic \noperation."
          (at 2.54 119.38 0)
          (effects
            (font
              (size 1.4224 1.4224))
            (justify left bottom)))
        (text "Added current limiting resistors to STEP and DIR"
          (at 5.08 5.08 0)
          (effects
            (font
              (size 0.8128 0.8128))
            (justify left bottom))))))
